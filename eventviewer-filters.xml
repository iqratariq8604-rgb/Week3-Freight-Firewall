<!--
  Event Viewer filters used in this project.
  Use: Windows Logs > Security > Filter Current Log > XML > Edit query manually
  Paste ONE QueryList at a time.
-->

<!-- Filter A: Finance (.45) connections ALLOWED (5156) -->
<QueryList><Query Id="0" Path="Security"><Select Path="Security">*[System[(EventID=5156)]] and *[EventData[Data[@Name='SourceAddress']='192.168.56.45' or Data[@Name='DestAddress']='192.168.56.45']]</Select></Query></QueryList>

<!-- Filter B: Guest (.101) packets DROPPED on the Billing Portal port (5152) -->
<QueryList><Query Id="0" Path="Security"><Select Path="Security">*[System[(EventID=5152)]] and *[EventData[Data[@Name='SourceAddress']='192.168.56.101' and Data[@Name='DestPort']='8080']]</Select></Query></QueryList>

<!-- Filter C: Firewall rule changes (add / modify / delete) -->
<QueryList><Query Id="0" Path="Security"><Select Path="Security">*[System[(EventID=4946 or EventID=4947 or EventID=4948)]]</Select></Query></QueryList>
